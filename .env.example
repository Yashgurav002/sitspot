# Database
DATABASE_URL=

# LLM (OpenAI-compatible: AI Studio / OpenRouter / Ollama)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # AI Studio (Gemma 4); Ollama: http://localhost:11434/v1
LLM_API_KEY=
CHAT_LLM_BASE_URL=http://localhost:11434/v1   # fast local Gemma 3 for voice turns
LLM_TIMEOUT_MS=180000                # scripts/notes (Gemma 4 thinks before answering)
LLM_MODEL_CHAT=gemma3:1b             # fast model for voice turns
LLM_MODEL_SCRIPT=gemma-4-31b-it      # call scripts (written ahead of time)
LLM_MODEL_NOTE=gemma-4-31b-it        # or a local Ollama fine-tune name
NOTE_LLM_BASE_URL=                    # set to http://localhost:11434/v1 for a local fine-tuned note model
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text

# Data
EBIRD_API_KEY=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=                   # only for Temporal Cloud

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
VOICE_SHARED_SECRET=
MY_PHONE_E164=+91XXXXXXXXXX

# Push fallback
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Security
CRON_SECRET=
ADMIN_PASSCODE=                     # hackathon shortcut: single-user sign-in

# Observability
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# Web (Next reads apps/web/.env*, not this file). Default: same-origin /api, proxied to API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=               # only for an API on another origin
API_INTERNAL_URL=                  # /api proxy target (runtime), default http://localhost:8787; on Vercel https://<NGROK_DOMAIN>

# Local dev: leave DATABASE_URL empty to use an embedded PGlite database at this path
PGLITE_DIR=.pglite
API_PORT=8787
SESSION_SECRET=                     # falls back to CRON_SECRET
ADMIN_EMAIL=me@sitspot.local
WEB_ORIGIN=http://localhost:3000   # laptop hosting: the tunnel origin
COOKIE_CROSS_SITE=                  # keep empty with the /api proxy; 1 only when web and api are on different sites
MCP_TOKEN=                          # bearer token for /mcp clients
NEXT_PUBLIC_SENTRY_DSN=              # web app Sentry (empty = off)
SENTRY_ORG=                          # only for source-map upload
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                   # secret; source maps upload only when set
NGROK_DOMAIN=                        # your free ngrok dev domain, e.g. xyz.ngrok-free.dev
PROXY_SECRET=                        # same random value on Vercel (web) and here: API trusts the proxy's client IP for the login rate limit
# Twilio-direct calls (new Twilio trials reject ElevenLabs' outbound-call API): we dial via Twilio REST,
# Twilio fetches TwiML from PUBLIC_API_URL/v1/voice/twiml/<token>, which connects to the ElevenLabs agent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                  # trial: the shared number shown in Twilio's "Try out Voice" (From)
PUBLIC_API_URL=                      # https://<NGROK_DOMAIN>
